@misc{yuIfQADatasetOpendomain2023,
  title = {{{IfQA}}: {{A Dataset}} for {{Open-domain Question Answering}} under {{Counterfactual Presuppositions}}},
  shorttitle = {{{IfQA}}},
  author = {Yu, Wenhao and Jiang, Meng and Clark, Peter and Sabharwal, Ashish},
